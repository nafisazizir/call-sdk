{
  "name": "@call-adapter/pipeline",
  "version": "0.0.0",
  "description": "Optional voice pipeline for Call SDK: stages (VAD, turn detection), say()/transcript/barge-in on top of the raw media plane",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "call-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "call",
    "call-sdk",
    "voice",
    "pipeline",
    "vad",
    "turn-detection",
    "barge-in",
    "typescript"
  ],
  "license": "MIT"
}
