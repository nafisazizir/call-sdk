    "knip": "^5.85.0",
    "konsistent": "0.0.1-alpha.24",
    "tsx": "^4.22.3",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "ultracite": "7.2.4",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.30.3"
